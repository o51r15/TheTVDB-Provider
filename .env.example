# --- required -----------------------------------------------------------
# A TheTVDB v4 API key. Keys are issued per PROJECT, not per user:
#   https://www.thetvdb.com/dashboard/account/apikey
TVDB_API_KEY=

# Each end user's own subscriber PIN, paired with the project key above.
# Leave blank only if your key carries a negotiated commercial licence -
# a user-supported key needs a PIN and will fail /login without one.
TVDB_PIN=

# --- ordering -----------------------------------------------------------
# Which orders to expose as providers. Each becomes its own agent in
# Plex, so choosing the agent is how a user chooses the order:
#
#   official (or 'aired')  Aired Order
#   dvd                    DVD Order
#   absolute               Absolute Order
#   alternate              Alternate Order
#   regional               Regional Order
#   altdvd                 Alternate DVD Order
#   alttwo                 Alternate Order 2
#   default                whichever order the series itself calls default
#
# Unset registers: official, dvd, absolute, alternate.
# GET /orders lists what TheTVDB currently offers and what is registered.
#TVDB_ORDER_PROVIDERS=official,dvd,absolute,alternate

# Per-series exceptions, so one library can mix orders. Keyed by TheTVDB
# series id; the override beats whichever provider the library uses.
#   TVDB_ORDER_OVERRIDES=78874:dvd,81797:absolute
#TVDB_ORDER_OVERRIDES=

# When a series has no episodes in the requested order, serve its default
# order instead of nothing. Off means such a series appears empty, and
# Plex treats an empty container as final rather than retrying.
#TVDB_ORDER_FALLBACK=true

# --- language -----------------------------------------------------------
# 3-letter TheTVDB language code. Translations are preferred over the
# series' original-language text, so a Japanese show reads in English
# rather than romaji.
#TVDB_LANGUAGE=eng
#TVDB_LANGUAGE_FALLBACKS=eng

# --- matching -----------------------------------------------------------
# Honour a {tvdb-121361} id in a folder or file name. A provider cannot
# influence Plex's scanner at all, so an id hint is the only reliable way
# to pin a show that keeps matching wrong.
#TVDB_MATCH_BY_ID_HINT=true
#TVDB_MATCH_BY_FILENAME=true
#TVDB_STRIP_PATH=true
#TVDB_MAX_RESULTS=20
#TVDB_MAX_PAGE_SIZE=500
#TVDB_MAX_EPISODE_PAGES=40

# --- metadata -----------------------------------------------------------
#TVDB_INCLUDE_CAST=true
#TVDB_INCLUDE_CREW=true
#TVDB_MAX_CAST=40
#TVDB_ARTWORK_LANGUAGE_FILTER=true
#TVDB_COLLECTIONS_FROM_NETWORKS=false
#TVDB_COLLECTIONS_FROM_GENRES=false

# --- identity -----------------------------------------------------------
# Each provider's identifier is this plus the order, e.g.
# tv.plex.agents.custom.tvdb.absolute. It must start with
# "tv.plex.agents.custom." or Plex rejects the registration.
#TVDB_IDENTIFIER=tv.plex.agents.custom.tvdb
#TVDB_TITLE=TheTVDB

# --- service ------------------------------------------------------------
#TVDB_API_BASE=https://api4.thetvdb.com/v4
#TVDB_TIMEOUT=30
#TVDB_RETRIES=3
#TVDB_CACHE_TTL=3600
#TVDB_STATIC_CACHE_TTL=604800
#TVDB_CACHE_MAX_ENTRIES=2000
#TVDB_TOKEN_TTL=2592000
#TVDB_LOG_LEVEL=INFO
