# --- required -----------------------------------------------------------
# A TheTVDB v4 API key. Keys are issued per PROJECT, not per user:
#   https://www.thetvdb.com/dashboard/account/apikey
TVDB_API_KEY=

# Each end user's own subscriber PIN, paired with the project key above.
# Leave blank only if your key carries a negotiated commercial licence -
# a user-supported key needs a PIN and will fail /login without one.
TVDB_PIN=

# --- ordering -----------------------------------------------------------
# Episode order is picked per show in Plex (Edit > Advanced > Episode
# ordering), so there's nothing to set here. Up to v1.0.0 this file had
# TVDB_ORDER_PROVIDERS and TVDB_ORDER_OVERRIDES. Both are gone and are
# ignored if still set.

# If a show has no episodes in aired order, serve its default order
# instead of nothing. Off means such a show appears empty, and Plex treats
# an empty answer as final rather than retrying.
#TVDB_ORDER_FALLBACK=true

# TheTVDB sometimes has an order that stops short of the show. By default
# those are still listed, and picking one leaves the missing episodes
# without metadata. Set this to true to only list an order (DVD, absolute
# and so on) if it has every released episode.
#TVDB_FULL_ORDERS_ONLY=false

# --- language -----------------------------------------------------------
# 3-letter TheTVDB language code. Translations are preferred over the
# series' original-language text, so a Japanese show reads in English
# rather than romaji.
#TVDB_LANGUAGE=eng
#TVDB_LANGUAGE_FALLBACKS=eng

# --- matching -----------------------------------------------------------
# Honour a {tvdb-121361} id in a folder or file name. A provider cannot
# influence Plex's scanner at all, so an id hint is the only reliable way
# to pin a show that keeps matching wrong.
#TVDB_MATCH_BY_ID_HINT=true
#TVDB_MATCH_BY_FILENAME=true
#TVDB_STRIP_PATH=true
#TVDB_MAX_RESULTS=20
#TVDB_MAX_PAGE_SIZE=500
#TVDB_MAX_EPISODE_PAGES=40

# --- metadata -----------------------------------------------------------
#TVDB_INCLUDE_CAST=true
#TVDB_INCLUDE_CREW=true
#TVDB_MAX_CAST=40
#TVDB_ARTWORK_LANGUAGE_FILTER=true
#TVDB_COLLECTIONS_FROM_NETWORKS=false
#TVDB_COLLECTIONS_FROM_GENRES=false

# --- identity -----------------------------------------------------------
# The provider's identifier. It must start with "tv.plex.agents.custom."
# or Plex rejects the registration. Changing it later means re-matching
# every show.
#TVDB_IDENTIFIER=tv.plex.agents.custom.tvdb
#TVDB_TITLE=TheTVDB

# --- service ------------------------------------------------------------
#TVDB_API_BASE=https://api4.thetvdb.com/v4
#TVDB_TIMEOUT=30
#TVDB_RETRIES=3
#TVDB_CACHE_TTL=3600
#TVDB_STATIC_CACHE_TTL=604800
#TVDB_CACHE_MAX_ENTRIES=2000
#TVDB_TOKEN_TTL=2592000
#TVDB_LOG_LEVEL=INFO
